*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
htmlcov/
*.log
/output/
/tmp/

# Superset metadata, persistent volumes and connection exports
**/superset_home/
**/superset_metadata/
**/volumes/
**/metadata/
*.db
*.sqlite
*.sqlite3
**/connections*.yaml
**/connections*.yml
**/connections*.json
**/database_export*

# Generated data is denied by default; aggregate CSV exceptions need review.
