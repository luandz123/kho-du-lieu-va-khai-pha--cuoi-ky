# Template only: fill values in your local .env; do not send credentials in chat.
# No database is created by this file. Names/users must be agreed at setup.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Superset has a different LOCAL file: dashboard/superset/.env
# See dashboard/superset/.env.example; never reuse DW credentials for metadata.

# 12A: use the guarded integration entry point, not production CLI with another DB name.
# ML CLI --source dw reads process PG* variables (local values, never send in chat):
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=<verified-local-integration-database>
# PGUSER=<local-read-only-account>
# PGPASSWORD=<set-locally>
# PGOPTIONS=-c default_transaction_read_only=on -c timezone=UTC
